<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{ subject }}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background-color: #f6f7f9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #191d23;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper { padding: 32px 16px; }
    .outer {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #e8eaed;
      box-shadow: 0 10px 40px rgba(15, 23, 42, 0.08);
    }
    .header {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      padding: 28px 40px;
      text-align: center;
    }
    .header img { max-height: 32px; }
    .header h1 {
      color: #ffffff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.02em;
      margin-top: 6px;
    }
    .body { padding: 36px 40px 28px; }
    .footer {
      padding: 20px 40px;
      background: #f8fafc;
      border-top: 1px solid #e8eaed;
      color: #7b8494;
      font-size: 12px;
      text-align: center;
    }
    .footer a { color: #2563eb; text-decoration: none; }
    h2 { font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 10px; }
    p { color: #4b5563; margin-bottom: 14px; font-size: 15px; }
    .otp {
      display: block;
      width: fit-content;
      margin: 24px auto;
      padding: 14px 28px;
      background: #eff6ff;
      border: 1px dashed #93c5fd;
      border-radius: 10px;
      font-size: 30px;
      font-weight: 700;
      letter-spacing: 8px;
      color: #1d4ed8;
      font-variant-numeric: tabular-nums;
    }
    .btn {
      display: inline-block;
      margin: 18px 0;
      padding: 12px 28px;
      background: #2563eb;
      color: #ffffff !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      border-radius: 8px;
    }
    .muted { color: #6b7280; font-size: 13px; }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }
    .table td, .table th {
      padding: 10px 12px;
      border-bottom: 1px solid #e8eaed;
      font-size: 14px;
    }
    .table th { text-align: left; color: #6b7280; font-weight: 500; }
    .table td { color: #0f172a; }
    .total-row td { border-top: 2px solid #e8eaed; font-weight: 700; color: #0f172a; }
    .note {
      background: #f8fafc;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 13px;
      color: #6b7280;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="outer">
      <div class="header">
        <h1>ASATECH</h1>
      </div>
      <div class="body">
        {% block content %}{% endblock %}
      </div>
      <div class="footer">
        <p>&copy; {{ year }} ASATECH &middot; Premium Gadgets</p>
        <p class="muted">
          You are receiving this email because of activity on your ASATECH account.<br>
          Questions? <a href="mailto:support@asatech.ng">support@asatech.ng</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>