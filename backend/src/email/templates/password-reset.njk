{% extends "base.njk" %}

{% block content %}
  <h2>Password reset code</h2>
  <p>Hi {{ user.name }},</p>
  <p>
    We received a request to reset your ASATECH password. Use the one-time code
    below to set a new password.
  </p>
  <span class="otp">{{ otp }}</span>
  <p class="muted">
    This code expires in {{ expiresInMinutes }} minutes. Never share this code with
    anyone.
  </p>
  <div class="note">If you didn't request a password reset, you can safely ignore this email — your password will not be changed.</div>
{% endblock %}