# =============================================================================
# ASATECH Frontend Environment
# =============================================================================
# Copy this file to `.env` at the REPOSITORY ROOT (not inside frontend/).
# Vite only reads env files from the project root.
#
# All variables MUST be prefixed with `VITE_` — anything else is stripped
# from the client bundle. Only place PUBLIC values here.
# =============================================================================

# Backend API base URL (include /api/v1)
# Development: http://localhost:8080/api/v1
# Production:  https://api.asatech.ng/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Paystack PUBLIC key (safe for the browser)
# NEVER put the SECRET key here — it belongs on the backend only.
# Test key format: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live key format: pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=

# Application mode (development, staging, production)
VITE_APP_MODE=development

# Application display name
VITE_APP_NAME=ASATECH
